{
  "name": "grook",
  "version": "1.0.0",
  "private": true,
  "description": "LINE 群組 bot：被 @ 時整理主人自己的 X 貼文與轉發",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test",
    "demo": "tsx src/demo.ts"
  },
  "dependencies": {
    "@line/bot-sdk": "^10.8.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
