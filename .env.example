# 填值步驟見 docs/setup.md（可重複使用）
# LINE Messaging API（從 LINE Developers Console 複製）
# 本機可用 replace_me；正式環境務必換成真實值，且不要 commit
LINE_CHANNEL_SECRET=replace_me
LINE_CHANNEL_ACCESS_TOKEN=replace_me

# 群組裡 @ 這個顯示名也會觸發（預設 Grook）
LINE_BOT_DISPLAY_NAME=Grook

# X / Twitter
# mock：本機用假資料，不打真實 API（v1 預設）
# api：介面已留，實作仍是 TODO，請勿當預設、也不要用爬蟲
X_PROVIDER=mock
X_OWNER_HANDLE=replace_me
X_BEARER_TOKEN=replace_me

# 迷因敘事按需（@Grook 迷因／敘事／meme／narrative）
# mock：假資料測分流；live：DexScreener 公開 API（敘事仍嚴篩，可能 0 候選）
MEME_PROVIDER=mock

PORT=3000
DATA_DIR=./data
